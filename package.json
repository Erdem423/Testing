{
  "name": "peaka-stripe-tests",
  "version": "1.0.0",
  "description": "Jest test suite validating Peaka's Stripe connector against the Peaka Partner API",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:races": "jest --config jest.races.config.js",
    "web": "node server.js",
    "check:refs": "node scripts/check-refs.js",
    "check:meta": "node scripts/check-meta.js",
    "check:names": "node scripts/check-names.js",
    "check": "npm run check:meta && npm run check:names && npm run check:refs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "jest": "^30.4.2",
    "jest-junit": "^17.0.0"
  },
  "dependencies": {
    "express": "^5.2.1"
  }
}
